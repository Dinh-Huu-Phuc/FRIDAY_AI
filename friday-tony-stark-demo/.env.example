# FRIDAY Local Core
FRIDAY_API_HOST=127.0.0.1
FRIDAY_API_PORT=8001
FRIDAY_LOCAL_ONLY=true
FRIDAY_EXPOSE_API_DOCS=false
FRIDAY_AUTO_OPEN_BROWSER=true
FRIDAY_BROWSER_PATH=
FRIDAY_CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
FRIDAY_START_MODE=fast
FRIDAY_BACKGROUND_WARMUP=true
FRIDAY_INITIAL_STATE=active
FRIDAY_WAKE_PHRASE=friday wake up
FRIDAY_SLEEP_PHRASE=friday sleep
FRIDAY_LOCAL_WAKE_WORD=true
FRIDAY_OLLAMA_PRELOAD=true
FRIDAY_WINDOW_SLEEP_ENABLED=true
FRIDAY_WINDOW_SNAPSHOT_PATH=
FRIDAY_WINDOW_RESTORE_ON_STARTUP=true

# Voice and model providers
STT_PROVIDER=sarvam
LLM_PROVIDER=gemini
TTS_PROVIDER=sarvam
SARVAM_STT_LANGUAGE=en-IN
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_SPEAKER=priya
SARVAM_API_KEY=

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Language models and speech providers
GOOGLE_API_KEY=
FRIDAY_VISION_MODEL=gemma3:4b
FRIDAY_VISION_BASE_URL=http://127.0.0.1:11434
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# STT refinement
STT_REFINER_ENABLED=true
STT_REFINER_PROVIDER=groq
STT_REFINER_TIMEOUT=4.0

# Google Cloud credentials (optional Google STT/TTS fallback)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_STT_LANGUAGE=en-US
GOOGLE_TTS_LANGUAGE=en-US
GOOGLE_TTS_VOICE_NAME=en-US-Wavenet-F

# Current information
NEWSDATA_API_KEY=
NEWS_DEFAULT_LANGUAGE=en
NEWS_DEFAULT_COUNTRY=vn
NEWS_DEFAULT_LIMIT=6
NEWS_REQUEST_TIMEOUT=8
WEATHERMAP_API_KEY=

# Optional integrations
SUPABASE_URL=
SUPABASE_API_KEY=

# Batch training scheduler
BATCH_TRAINING_ENABLED=false
BATCH_TRAINING_CHECK_INTERVAL_SEC=300
BATCH_TRAINING_DAILY_TIME_UTC=02:00
BATCH_TRAINING_MIN_PENDING_SAMPLES=100
