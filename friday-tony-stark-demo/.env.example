# LiveKit credentials (get from https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project-xxxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq AI API key
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# STT refiner settings
STT_REFINER_ENABLED=true
STT_REFINER_PROVIDER=groq
STT_REFINER_TIMEOUT=4.0


# OpenAI API key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxx

# NewsData API key (https://newsdata.io/)
NEWSDATA_API_KEY=
NEWS_DEFAULT_LANGUAGE=#your-default-language-code (e.g., "en" for English, "vi" for Vietnamese)
NEWS_DEFAULT_COUNTRY=#your-default-country-code (e.g., "us" for United States, "vn" for Vietnam)
NEWS_DEFAULT_LIMIT=#number of news articles to fetch for each request
NEWS_REQUEST_TIMEOUT=#number of seconds to wait for news API response before timing out 

# Weather API key (get from https://home.openweathermap.org/api_keys)
WEATHERMAP_API_KEY=

# Deepgram API key (get from https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Google Cloud credentials (used when STT_PROVIDER = "google")
# Option 1 – path to a service-account JSON file (download from GCP Console → IAM → Service Accounts)
# Option 2 – leave blank and run: gcloud auth application-default login
# Make sure the "Cloud Speech-to-Text API" is enabled in your GCP project.
GOOGLE_APPLICATION_CREDENTIALS=

# Supabase configuration for ticketing system
SUPABASE_URL=https://your-project-id.supabase.co/rest/v1
SUPABASE_API_KEY=your-supabase-api-key

GOOGLE_API_KEY=you-google-api-key (from https://aistudio.google.com/projects)

# Batch training scheduler
BATCH_TRAINING_ENABLED= #true or false
BATCH_TRAINING_CHECK_INTERVAL_SEC= #number of seconds between checks for pending training samples
BATCH_TRAINING_DAILY_TIME_UTC= #time of day to run batch training (in UTC, format HH:MM)
BATCH_TRAINING_MIN_PENDING_SAMPLES= #minimum number of pending training samples required to trigger batch training

